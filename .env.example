BOT_TOKEN=123456:ABC-DEF-your-bot-token-here
OWNER_ID=123456789
# Docker, bot only (Ollama on host): OLLAMA_BASE_URL=http://host.docker.internal:11434
# Docker, --profile with-ollama:     OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
MAX_PER_HOUR=10
# Optional: proxy for Telegram API calls (http/socks URL), e.g. http://127.0.0.1:10809
# TELEGRAM_PROXY=http://127.0.0.1:10809
